<!doctype html>
<html {{ site.language_attributes }} data-theme="{{ theme.mods.data_theme|default('light') }}">
<head>
    <meta charset="{{ site.charset }}" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {{ function('wp_head') }}
</head>
<body class="{{ body_class }}" data-template="lcfa-empty.twig">
    {{ function('wp_body_open') }}
    {% if function('function_exists', 'lc_custom_header') %}
        {{ function('lc_custom_header', 1) }}
    {% else %}
        {{ function('lc_get_header', 1) }}
    {% endif %}
    <main id="theme-main">
        {{ post.content }}
    </main>
    {% if function('function_exists', 'lc_custom_footer') %}
        {{ function('lc_custom_footer', 1) }}
    {% else %}
        {{ function('lc_get_footer', 1) }}
    {% endif %}
    {{ function('wp_footer') }}
</body>
</html>
